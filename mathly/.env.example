# ── Mathly configuration ──────────────────────────────────────────────
# Copy to .env and fill in what you need. Every integration is optional:
# without keys Mathly runs fully on its built-in math engine & tutor.

# Server
PORT=8787
PUBLIC_URL=http://localhost:5173        # public origin (used for OAuth redirect URIs)
DATABASE_PATH=data/mathly.db
UPLOAD_DIR=data/uploads
ADMIN_EMAILS=you@example.com            # these emails become admins when they register

# AI (Claude). Enables conversational tutoring, homework photo reading,
# AI course generation and richer presentation feedback.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_RATE_LIMIT_PER_MIN=20
# AI_PROVIDER=none                     # force the built-in engines only

# Sign in with Google  (redirect URI: $PUBLIC_URL/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Microsoft (redirect URI: $PUBLIC_URL/api/auth/oauth/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Sign in with Apple (redirect URI: $PUBLIC_URL/api/auth/oauth/apple/callback)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                      # contents of the .p8 key, newlines as \n
