# ---- Sign-in (required) ----
AUTH_ALLOWED_EMAILS=you@example.com            # comma-separated allow-list
AUTH_PASSWORD_HASH=                            # generate with: npm run hash-password -- 'your password'
AUTH_SECRET=                                   # 32+ random characters (session signing + key encryption)
AUTH_WELCOME_NAME=Mr Naqvi                     # shown after sign-in: "Welcome <name>"

# ---- Storage ----
# Netlify Blobs is used automatically on Netlify; local dev uses ./.data
# TRACE_STORAGE=blobs|fs

# ---- Optional providers (TRACE works without them using keyless public sources) ----
ANTHROPIC_API_KEY=            # Claude vision, AI chat with tools, explanations, AI comparison
AI_MODEL=claude-opus-5-5
GOOGLE_CLOUD_VISION_API_KEY=  # logo / landmark / OCR / web (reverse-image) detection
BRAVE_SEARCH_API_KEY=         # web, news, images, videos
TAVILY_API_KEY=               # web + news
SERPAPI_API_KEY=              # Google Lens reverse image search via SerpApi
GOOGLE_MAPS_API_KEY=          # Places API (New) + Geocoding
YOUTUBE_API_KEY=              # video metadata search
