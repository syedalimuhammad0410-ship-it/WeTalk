# ─── Required ──────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase: use the pooled/direct Postgres URL)
DATABASE_URL="postgresql://webscout:webscout@localhost:5432/webscout"
# Public base URL of this deployment (used for OAuth redirects and links)
APP_URL="http://localhost:3000"
# 32+ character random secret used to encrypt stored API keys and OAuth tokens.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ─── Optional: server-wide integration defaults ───────────────────────
# If set, these are used for every workspace that has not saved its own key
# in Settings → Integrations. Workspace keys are encrypted at rest.
ANTHROPIC_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# ─── Optional: Google OAuth (Google sign-in + Gmail sending/receiving) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Optional: runtime ────────────────────────────────────────────────
# "inline" runs background jobs inside the web server process (single instance).
# "external" expects `npm run worker` to be running separately.
JOB_RUNNER="inline"
# Allow the clearly-labelled email SANDBOX provider (no real email is sent).
ENABLE_EMAIL_SANDBOX="true"
# Comma-separated emails that become system administrators on sign-up.
SYSTEM_ADMIN_EMAILS=""
